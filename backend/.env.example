PORT=3000

# Optional, comma-separated list of origins allowed to call this API from a
# browser. Leave unset to allow any origin (fine for now - auth is JWT-based,
# not cookies, so there's no CSRF exposure from an open CORS policy).
# CORS_ORIGIN=https://your-frontend.example.com

# Neon Postgres connection string (get your own from the Neon dashboard).
# DATABASE_URL takes priority over the discrete PG* vars below if both are set.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require

# Used to sign login JWTs - set a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# Used once by `npm run seed` to bootstrap the first admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

